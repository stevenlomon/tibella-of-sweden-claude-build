{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/cart/**",
              "components/collection/**",
              "components/faq/**",
              "components/navigation/**",
              "components/product/**",
              "components/trust/**",
              "ui_kits/storefront/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionFAQ'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|breakpoint|state|text1|text2|text3|key|ref|className|style|children)$/]",
        "message": "<AccordionFAQ> doesn't accept that prop. Declared props: className, style, breakpoint, state, text1, text2, text3."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionFAQ'] > JSXAttribute[name.name='breakpoint'] > Literal[value!=/^(?:desktop|mobile)$/]",
        "message": "<AccordionFAQ> breakpoint must be one of 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionFAQ'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:closed|open)$/]",
        "message": "<AccordionFAQ> state must be one of 'closed' | 'open'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionProductDetails'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|label|text1|key|ref|className|style|children)$/]",
        "message": "<AccordionProductDetails> doesn't accept that prop. Declared props: className, style, label, text1."
      },
