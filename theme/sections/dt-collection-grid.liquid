{%- assign heading_id = 'collections-heading-' | append: section.id -%}

<section
  class="dt-section dt-collections"
  id="{{ section.id }}"
  {%- if section.settings.heading != blank %} aria-labelledby="{{ heading_id }}"{%- endif -%}
>
  <div class="dt-collections__container">
    <div class="dt-collections__header">
      {%- if section.settings.heading != blank -%}
        <h2 id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="dt-collections__nav">
        <button type="button" class="dt-collections__nav-btn dt-collections__nav-btn--prev" aria-label="Previous" disabled>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="dt-collections__nav-btn dt-collections__nav-btn--next" aria-label="Next">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    <ul class="dt-collection-grid" role="list">
      {%- for block in section.blocks -%}
        {% render 'dt-collection-card',
          collection: block.settings.collection,
          image: block.settings.image,
          title: block.settings.title,
          fallback_asset: block.settings.fallback_asset,
          shopify_attributes: block.shopify_attributes
        %}
      {%- endfor -%}
    </ul>
  </div>

  <script>
    (function() {
      var section = document.getElementById('{{ section.id }}');
      if (!section) return;
      var grid = section.querySelector('.dt-collection-grid');
      var prev = section.querySelector('.dt-collections__nav-btn--prev');
      var next = section.querySelector('.dt-collections__nav-btn--next');
      if (!grid || !prev || !next) return;

      function updateButtons() {
        prev.disabled = grid.scrollLeft <= 4;
        next.disabled = grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 4;
      }

      prev.addEventListener('click', function() {
        var card = grid.querySelector('.dt-collection-card');
        if (card) grid.scrollBy({ left: -(card.offsetWidth + 12), behavior: 'smooth' });
      });

      next.addEventListener('click', function() {
        var card = grid.querySelector('.dt-collection-card');
        if (card) grid.scrollBy({ left: card.offsetWidth + 12, behavior: 'smooth' });
      });

      grid.addEventListener('scroll', updateButtons, { passive: true });
      updateButtons();
    })();
  </script>
</section>

{% schema %}
{
  "name": "t:sections.dt_collection_grid.name",
  "tag": "section",
  "class": "shopify-section--dt-collection-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.dt_collection_grid.settings.heading.label",
      "default": "Shoppa efter kategori"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.dt_collection_grid.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.dt_collection_grid.blocks.collection.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.dt_collection_grid.blocks.collection.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.dt_collection_grid.blocks.collection.settings.title.label"
        },
        {
          "type": "select",
          "id": "fallback_asset",
          "label": "t:sections.dt_collection_grid.blocks.collection.settings.fallback_asset.label",
          "options": [
            { "value": "dt-collection-clothing-shoes.png", "label": "Clothing & Shoes" },
            { "value": "dt-collection-bags-jewelry.png", "label": "Bags & Jewelry" },
            { "value": "dt-collection-home-living.png", "label": "Home & Living" },
            { "value": "dt-collection-gifts-hobbies.png", "label": "Gifts & Hobbies" },
            { "value": "dt-collection-christmas.png", "label": "Christmas Shop" },
            { "value": "dt-collection-clothing.png", "label": "Clothing" },
            { "value": "dt-collection-shoes.png", "label": "Shoes" },
            { "value": "dt-collection-home.png", "label": "Home" },
            { "value": "dt-collection-gifts.png", "label": "Gifts" },
            { "value": "dt-collection-seasonal.png", "label": "Seasonal" },
            { "value": "dt-collection-accessories.png", "label": "Accessories" }
          ],
          "default": "dt-collection-clothing-shoes.png"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.dt_collection_grid.presets.name",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
