{%- liquid
  assign hero_alt = section.settings.image.alt | default: section.settings.heading | escape
-%}

<section
  class="dt-section dt-hero"
  id="{{ section.id }}"
  style="--dt-hero-wash-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="dt-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'dt-hero__image',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          alt: hero_alt
      }}
    {%- else -%}
      <img
        class="dt-hero__image"
        src="{{ 'dt-hero.png' | asset_url }}"
        alt="{{ hero_alt }}"
        width="2160"
        height="728"
        loading="eager"
      >
    {%- endif -%}
    <span class="dt-hero__wash" aria-hidden="true"></span>
  </div>

  <div class="dt-hero__content page-width">
    <div class="dt-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="dt-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="dt-hero__text">{{ section.settings.text | escape | newline_to_br }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="dt-button dt-button--primary" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.dt_hero.name",
  "tag": "section",
  "class": "shopify-section--dt-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.dt_hero.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.dt_hero.settings.eyebrow.label",
      "default": "Thoughtfully chosen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.dt_hero.settings.heading.label",
      "default": "What you wear & how you live, weaved beautifully together"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.dt_hero.settings.text.label",
      "default": "A thoughtful edit of easy fashion, comfortable footwear, and beautiful things for home. Chosen for the woman you are now."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.dt_hero.settings.button_label.label",
      "default": "Shop by collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.dt_hero.settings.button_link.label"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.dt_hero.settings.overlay_opacity.label",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:sections.dt_hero.presets.name"
    }
  ]
}
{% endschema %}
