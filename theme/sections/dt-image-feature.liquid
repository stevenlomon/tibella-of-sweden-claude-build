{%- liquid
  assign feature_alt = section.settings.image.alt | default: section.settings.heading | escape
-%}

<section class="dt-section dt-image-feature" id="{{ section.id }}">
  <div class="page-width">
    <div class="dt-image-feature__inner">
      <div class="dt-image-feature__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dt-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="dt-image-feature__text">{{ section.settings.text | escape | newline_to_br }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="dt-link-cta" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <figure class="dt-image-feature__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              class: 'dt-image-feature__image',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: feature_alt
          }}
        {%- else -%}
          <img
            class="dt-image-feature__image"
            src="{{ 'dt-split.png' | asset_url }}"
            alt="{{ feature_alt }}"
            width="1200"
            height="800"
            loading="lazy"
          >
        {%- endif -%}
      </figure>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.dt_image_feature.name",
  "tag": "section",
  "class": "shopify-section--dt-image-feature",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.dt_image_feature.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.dt_image_feature.settings.eyebrow.label",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.dt_image_feature.settings.heading.label",
      "default": "Osäker på var du ska börja?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.dt_image_feature.settings.text.label",
      "default": "Utforska hela sortimentet — från vardagsstil och stickat till väskor och stövlar."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.dt_image_feature.settings.button_label.label",
      "default": "Shoppa allt"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.dt_image_feature.settings.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.dt_image_feature.presets.name"
    }
  ]
}
{% endschema %}
