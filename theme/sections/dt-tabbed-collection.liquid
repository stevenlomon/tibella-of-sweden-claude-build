{%- liquid
  assign heading_id = 'tabbed-heading-' | append: section.id
  assign products_to_show = section.settings.products_to_show | default: 5
  assign grid_count = products_to_show | minus: 1
-%}

<section
  class="dt-section dt-tabbed-collection"
  id="{{ section.id }}"
  {%- if section.settings.heading != blank %} aria-labelledby="{{ heading_id }}"{%- endif -%}
>
  <div class="dt-tabbed-collection__container">
    <div class="dt-tabbed-collection__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="dt-tabbed-collection__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="dt-tabbed-collection__desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="dt-tabbed-collection__tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              class="dt-tab-pill{% if forloop.first %} dt-tab-pill--active{% endif %}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="dt-panel-{{ section.id }}-{{ forloop.index0 }}"
              id="dt-tab-{{ section.id }}-{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign tab_collection = block.settings.collection | default: section.settings.collection
      -%}
      <div
        class="dt-tabbed-collection__panel{% unless forloop.first %} dt-tabbed-collection__panel--hidden{% endunless %}"
        role="tabpanel"
        id="dt-panel-{{ section.id }}-{{ forloop.index0 }}"
        aria-labelledby="dt-tab-{{ section.id }}-{{ forloop.index0 }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        <div class="dt-tabbed-collection__grid">
          {%- if tab_collection != blank and tab_collection.products.size > 0 -%}
            <div class="dt-tabbed-collection__item dt-tabbed-collection__item--featured">
              {% render 'card-product',
                card_product: tab_collection.products.first,
                media_aspect_ratio: 'portrait',
                image_shape: 'default',
                lazy_load: true,
                show_secondary_image: true,
                show_vendor: false,
                show_rating: false,
                section_id: section.id,
                quick_add: 'none',
                product_view_context: 'collection'
              %}
            </div>
            <div class="dt-tabbed-collection__side">
              <ul class="dt-tabbed-collection__product-grid" role="list">
                {%- for product in tab_collection.products limit: grid_count offset: 1 -%}
                  <li class="dt-tabbed-collection__item">
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: 'portrait',
                      image_shape: 'default',
                      lazy_load: true,
                      show_secondary_image: true,
                      show_vendor: false,
                      show_rating: false,
                      section_id: section.id,
                      quick_add: 'none',
                      product_view_context: 'collection'
                    %}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- else -%}
            <div class="dt-tabbed-collection__item dt-tabbed-collection__item--featured">
              {% render 'card-product',
                show_vendor: false,
                media_aspect_ratio: 'portrait',
                image_shape: 'default',
                lazy_load: false,
                placeholder_image: 'product-apparel-1'
              %}
            </div>
            <div class="dt-tabbed-collection__side">
              <ul class="dt-tabbed-collection__product-grid" role="list">
                {%- for i in (2..products_to_show) -%}
                  <li class="dt-tabbed-collection__item">
                    {% liquid
                      assign ridx = i | minus: 2 | modulo: 4 | plus: 1
                      assign placeholder_image = 'product-apparel-' | append: ridx
                    %}
                    {% render 'card-product',
                      show_vendor: false,
                      media_aspect_ratio: 'portrait',
                      image_shape: 'default',
                      lazy_load: false,
                      placeholder_image: placeholder_image
                    %}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  <script>
    (function() {
      var section = document.getElementById('{{ section.id }}');
      if (!section) return;
      var tabs = section.querySelectorAll('.dt-tab-pill');
      var panels = section.querySelectorAll('[role="tabpanel"]');
      tabs.forEach(function(tab, index) {
        tab.addEventListener('click', function() {
          tabs.forEach(function(t) {
            t.classList.remove('dt-tab-pill--active');
            t.setAttribute('aria-selected', 'false');
          });
          panels.forEach(function(p) {
            p.hidden = true;
            p.classList.add('dt-tabbed-collection__panel--hidden');
          });
          tab.classList.add('dt-tab-pill--active');
          tab.setAttribute('aria-selected', 'true');
          if (panels[index]) {
            panels[index].hidden = false;
            panels[index].classList.remove('dt-tabbed-collection__panel--hidden');
          }
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Tabbed Collection",
  "tag": "section",
  "class": "shopify-section--dt-tabbed-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Utvalt för säsongen"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Säsongens lager, texturer och silhuetter. Utvalda för svenska dagar."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "All"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Collection",
      "blocks": [
        { "type": "tab", "settings": { "label": "Highlight" } },
        { "type": "tab", "settings": { "label": "Kappor" } },
        { "type": "tab", "settings": { "label": "Stickat" } }
      ]
    }
  ]
}
{% endschema %}
