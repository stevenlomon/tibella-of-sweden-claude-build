{%- liquid
  assign heading_id = 'tabbed-heading-' | append: section.id
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 5
-%}

<section
  class="dt-section dt-tabbed-collection"
  id="{{ section.id }}"
  {%- if section.settings.heading != blank %} aria-labelledby="{{ heading_id }}"{%- endif -%}
>
  <div class="dt-tabbed-collection__container">
    <div class="dt-tabbed-collection__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="dt-tabbed-collection__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="dt-tabbed-collection__desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="dt-tabbed-collection__tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              role="tab"
              class="dt-tab-pill{% if forloop.first %} dt-tab-pill--active{% endif %}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="dt-tabbed-collection__grid" role="list">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: products_to_show -%}
          <div class="dt-tabbed-collection__item{% if forloop.first %} dt-tabbed-collection__item--featured{% endif %}">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'portrait',
              image_shape: 'default',
              lazy_load: true,
              show_secondary_image: true,
              show_vendor: false,
              show_rating: false,
              section_id: section.id,
              quick_add: 'none',
              product_view_context: 'collection'
            %}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <div class="dt-tabbed-collection__item{% if forloop.first %} dt-tabbed-collection__item--featured{% endif %}">
            {% liquid
              assign ridx = forloop.index | modulo: 6
              if ridx == 0
                assign ridx = 6
              endif
              assign placeholder_image = 'product-apparel-' | append: ridx
            %}
            {% render 'card-product',
              show_vendor: false,
              media_aspect_ratio: 'portrait',
              image_shape: 'default',
              lazy_load: false,
              placeholder_image: placeholder_image
            %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="dt-tabbed-collection__cta">
        <a class="dt-button dt-button--outline" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>

  <script>
    (function() {
      var section = document.getElementById('{{ section.id }}');
      if (!section) return;
      var tabs = section.querySelectorAll('.dt-tab-pill');
      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          tabs.forEach(function(t) {
            t.classList.remove('dt-tab-pill--active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('dt-tab-pill--active');
          tab.setAttribute('aria-selected', 'true');
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Tabbed Collection",
  "tag": "section",
  "class": "shopify-section--dt-tabbed-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Utvalt för säsongen"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Säsongens lager, texturer och silhuetter. Utvalda för svenska dagar."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Products to show"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "All"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Collection",
      "blocks": [
        { "type": "tab", "settings": { "label": "Highlight" } },
        { "type": "tab", "settings": { "label": "Kappor" } },
        { "type": "tab", "settings": { "label": "Stickat" } }
      ]
    }
  ]
}
{% endschema %}
