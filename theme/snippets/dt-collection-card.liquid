{%- liquid
  assign card_title = title | default: collection.title | default: 'Collection'
  assign card_url = collection.url | default: routes.all_products_collection_url
  assign card_image = image | default: collection.featured_image
-%}

<li class="dt-collection-card" {{ shopify_attributes }}>
  <a class="dt-collection-card__link" href="{{ card_url }}">
    <div class="dt-collection-card__media">
      {%- if card_image != blank -%}
        {{
          card_image
          | image_url: width: 1200
          | image_tag:
            class: 'dt-collection-card__image',
            widths: '480, 720, 960, 1200',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 70vw',
            loading: 'lazy',
            alt: card_image.alt | default: card_title
        }}
      {%- elsif fallback_asset != blank -%}
        <img
          class="dt-collection-card__image"
          src="{{ fallback_asset | asset_url }}"
          alt="{{ card_title | escape }}"
          width="800"
          height="1066"
          loading="lazy"
        >
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'dt-collection-card__image' }}
      {%- endif -%}
      <span class="dt-collection-card__scrim" aria-hidden="true"></span>
      <span class="dt-collection-card__label">
        <span class="dt-collection-card__title">{{ card_title | escape }}</span>
        <svg class="dt-collection-card__arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </a>
</li>
