<div class="dt-product-trust-block">
  <ul class="dt-product-trust" role="list" aria-label="{{ 'products.product.dt_trust_label' | t }}">
    <li class="dt-product-trust__item">
      <img class="dt-product-trust__icon" src="{{ 'dt-trust-shipping.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
      <span class="dt-product-trust__title">{{ 'products.product.dt_trust_shipping' | t }}</span>
      <small class="dt-product-trust__detail">{{ 'products.product.dt_trust_shipping_detail' | t }}</small>
    </li>
    <li class="dt-product-trust__item">
      <img class="dt-product-trust__icon" src="{{ 'dt-trust-returns.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
      <span class="dt-product-trust__title">{{ 'products.product.dt_trust_returns' | t }}</span>
      <small class="dt-product-trust__detail">{{ 'products.product.dt_trust_returns_detail' | t }}</small>
    </li>
    <li class="dt-product-trust__item">
      <img class="dt-product-trust__icon" src="{{ 'dt-trust-secure.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
      <span class="dt-product-trust__title">{{ 'products.product.dt_trust_secure' | t }}</span>
      <small class="dt-product-trust__detail">{{ 'products.product.dt_trust_secure_detail' | t }}</small>
    </li>
    <li class="dt-product-trust__item">
      <img class="dt-product-trust__icon" src="{{ 'dt-trust-help.svg' | asset_url }}" alt="" width="20" height="20" loading="lazy">
      <span class="dt-product-trust__title">{{ 'products.product.dt_trust_support' | t }}</span>
      <small class="dt-product-trust__detail">{{ 'products.product.dt_trust_support_detail' | t }}</small>
    </li>
  </ul>
</div>
